@echo off
rem Return Checks: permite que la app abra la carpeta de los PDF en el OneDrive de esta computadora.
rem No necesita permisos de administrador. Se instala solo para este usuario de Windows.
set "RC=%LOCALAPPDATA%\ReturnChecks"
if not exist "%RC%" mkdir "%RC%"
powershell -NoProfile -ExecutionPolicy Bypass -Command "[IO.File]::WriteAllText($env:LOCALAPPDATA + '\ReturnChecks\rcopen.ps1', [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('')), [Text.Encoding]::UTF8)"
reg add "HKCU\Software\Classes\rcopen" /ve /d "URL:Return Checks - abrir carpeta" /f >nul
reg add "HKCU\Software\Classes\rcopen" /v "URL Protocol" /d "" /f >nul
reg add "HKCU\Software\Classes\rcopen\shell\open\command" /ve /d "powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File \"%RC%\rcopen.ps1\" \"%%1\"" /f >nul
echo.
echo  Listo. Ya puedes abrir las carpetas de los PDF desde la app Return Checks en esta computadora.
echo  La primera vez el navegador te pregunta si abrir: marca "Permitir siempre" y dale Abrir.
echo.
pause
